<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="C:/Users/giova/dev/github/OAC-25.2/LAB3/dev/simulation/qsim/" LAB3_Multiciclo -c TopDE</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
